# The landing and legal pages build with no environment variables.
# The web app (sign-up, onboarding, plan, account) needs these. Set the same keys in
# Vercel → Project → Settings → Environment Variables.

# The backend API, including /api. Must be on the same site as the web app, because
# the session cookies are SameSite=strict (production: https://api.zorr.app/api).
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Cloudflare Turnstile SITE key (public). Leave empty locally to skip the widget; the
# backend then skips the check too, as long as it has no TURNSTILE_SECRET_KEY.
# Cloudflare's published test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
